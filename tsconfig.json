{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "lib": [
      "es2022",
      "dom"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "useUnknownInCatchVariables": false,
    "allowImportingTsExtensions": true,
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/types.d.ts",
    "src/preload.js",
    "src/*.mts",
    "src/shared/*.mts",
    "src/docx-edit/*.mts",
    "src/renderer/globals.d.ts"
  ]
}
