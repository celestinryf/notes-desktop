{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [],
    "jsx": "react-jsx"
  },
  "include": [
    "src/types.d.ts",
    "src/renderer/globals.d.ts",
    "src/renderer/*.js",
    "src/editor/index.ts",
