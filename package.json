{
  "name": "notes-app",
  "version": "1.0.0",
  "description": "Tray-resident notes app launched by a global hotkey",
  "main": "src/main.mts",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/celestinryf/notes-desktop.git"
  },
  "homepage": "https://github.com/celestinryf/notes-desktop",
  "bugs": {
    "url": "https://github.com/celestinryf/notes-desktop/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-force-exit --test-timeout=60000 \"test/unit/**/*.test.js\"",
    "test:e2e": "node test/e2e.js",
    "icon": "electron scripts/make-icon.js",
    "install:shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcuts.ps1",
    "test:ui": "node --test --test-timeout=25000 test/ui.test.js",
    "test:all": "npm run typecheck && npm test && npm run test:ui && npm run test:e2e",
    "build": "npm run build:editor && npm run build:docx && npm run build:pdf && npm run build:code && npm run build:app",
    "build:editor": "esbuild src/editor/index.ts --bundle --format=iife --global-name=NotesEditor --target=chrome120 --minify --outfile=src/renderer/vendor/editor.bundle.js",
    "build:docx": "esbuild src/docx-view/index.ts --bundle --format=iife --global-name=DocxView --target=chrome120 --minify --outfile=src/renderer/vendor/docx.bundle.js",
    "build:pdf": "esbuild src/pdf-view/index.ts --bundle --format=iife --global-name=PdfView --target=chrome120 --minify --outfile=src/renderer/vendor/pdf.bundle.js",
    "shots": "node scripts/shots.js",
    "icons": "node scripts/make-icons.js",
    "build:code": "esbuild src/code/index.ts --bundle --format=iife --global-name=NotesCode --target=chrome120 --minify --outfile=src/renderer/vendor/code.bundle.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "build:app": "node scripts/build-renderer.js",
    "notices": "node scripts/make-notices.js",
    "bench": "node --expose-gc scripts/bench-scale.js",
    "vendor:katex": "node scripts/vendor-katex.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.10.2",
    "esbuild": "^0.28.2",
    "lucide-static": "1.51.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "codemirror-lang-bib": "0.2.4",
    "docx": "9.8.1",
    "docx-preview": "^0.4.1",
    "dugite": "^3.3.2",
    "jszip": "3.10.2",
    "katex": "0.19.1",
    "mammoth": "^1.13.0",
    "markdown-it": "14.3.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "synctex-js": "1.0.0",
    "tiptap-markdown": "^0.8.10",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}
