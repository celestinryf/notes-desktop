{
  "name": "notes-app",
  "version": "1.0.0",
  "description": "Tray-resident notes app launched by a global hotkey",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-force-exit --test-timeout=60000 \"test/unit/**/*.test.js\"",
    "test:e2e": "node test/e2e.js",
    "icon": "electron scripts/make-icon.js",
    "install:shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcuts.ps1",
    "test:ui": "node --test --test-timeout=25000 test/ui.test.js",
    "test:all": "npm test && npm run test:ui && npm run test:e2e",
    "build": "esbuild src/editor/index.js --bundle --format=iife --global-name=NotesEditor --target=chrome120 --minify --outfile=src/renderer/vendor/editor.bundle.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.49.1"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "mammoth": "^1.13.0",
    "tiptap-markdown": "^0.8.10"
  }
}
